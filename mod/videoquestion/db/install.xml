<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videoquestion/db" VERSION="20260918" COMMENT="XMLDB file for Moodle mod_videoquestion">
  <TABLES>
    <TABLE NAME="videoquestion" COMMENT="Defines videoquestion instances">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course videoquestion activity belongs to"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="name field for moodle instances"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="General introduction of the videoquestion activity"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Format of the intro field (MOODLE, HTML, MARKDOWN...)"/>
        <FIELD NAME="video_url" TYPE="char" LENGTH="1333" NOTNULL="true" SEQUENCE="false" COMMENT="URL of the video to be watched"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="videoquestion_questions" COMMENT="Submitted student questions for videoquestion activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="videoquestionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Foreign key to videoquestion.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="ID of student who submitted question"/>
        <FIELD NAME="question" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Original question submitted"/>
        <FIELD NAME="normalizedquestion" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Normalized lowercase trimmed single-space question for transparency"/>
        <FIELD NAME="normalizedhash" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="SHA-256 hash of normalized question"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_videoquestionid" TYPE="foreign" FIELDS="videoquestionid" REFTABLE="videoquestion" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="videoquestionid" UNIQUE="false" FIELDS="videoquestionid"/>
        <INDEX NAME="vq_normhash_idx" UNIQUE="true" FIELDS="videoquestionid, normalizedhash" COMMENT="Unique constraint preventing duplicate normalized questions per activity"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
